# Flask Secret Key
SECRET_KEY=your-super-secret-key-change-this

# PostgreSQL Database URL
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/resumes_db

# Render Cloud PostgreSQL example (Render automatically provides this):
# DATABASE_URL=postgres://user:password@hostname:5432/database_name

# Free initial export credits
DEFAULT_FREE_DOWNLOADS=1

# Flask environment: development, production
FLASK_ENV=development

