# Flask Secret Key
SECRET_KEY=your-super-secret-key-change-this

# PostgreSQL Database URL
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/resumes_db

# Render Cloud PostgreSQL example (Render automatically provides this):
# DATABASE_URL=postgres://user:password@hostname:5432/database_name

# Free initial export credits
DEFAULT_FREE_DOWNLOADS=1

# ==============================================================================
# Email Configuration
# ==============================================================================
# Active Provider: 'resend' (recommended for testing without custom domain),
#                  'zeptomail' (for when custom domain is purchased), or 'smtp'
EMAIL_PROVIDER=resend

# ------------------------------------------------------------------------------
# 1. RESEND (Current Testing Choice - No Custom Domain Required!)
# ------------------------------------------------------------------------------
# 1. Sign up free at https://resend.com
# 2. Generate an API Key under "API Keys" -> starts with re_...
# 3. For testing without buying a domain, use the free test domain: onboarding@resend.dev
#    (Note: Resend free tier sends test emails to the email address you registered at Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 2. ZEPTOMAIL (Future Production Choice - Once Domain is Purchased & Verified)
# ------------------------------------------------------------------------------
# Get your Send Mail Token from Zoho ZeptoMail Console -> Mail Agents -> Setup Info
ZEPTOMAIL_API_KEY=Zoho-enczapikey your-send-mail-token-here
# Use https://api.zeptomail.in/v1.1/email (India) or https://api.zeptomail.com/v1.1/email (US) or .eu
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
EMAIL_DELIVERY_METHOD=api

# ZeptoMail SMTP Alternative (if EMAIL_PROVIDER=smtp)
SMTP_SERVER=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=your-send-mail-token-here
SMTP_USE_TLS=true

# Sender Identity metadata
MAIL_FROM_NAME=ResumePortal Academic Nexus
MAIL_FROM_ADDRESS=onboarding@resend.dev

# Flask environment: development, production
FLASK_ENV=development
